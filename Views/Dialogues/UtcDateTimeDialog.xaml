<Window x:Class="UtcDateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClimateSim"
        mc:Ignorable="d"
        Title="UTC-Zeit setzen"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Datum -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Datum"
                                   Margin="0,0,0,4"/>
                    <DatePicker x:Name="dPicker" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    Width="170"/>
                </StackPanel>

                <!-- Uhrzeit -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Uhrzeit"
                                   Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Height="{Binding ElementName=dPicker, Path=ActualHeight}">
                        
                        <TextBox Width="40"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <i:Interaction.Behaviors>
                                <local:NumericTimeTextBehavior Mode="Hour"
                                                               AllowEmpty="False"
                                                               PadOnLostFocus="True"
                                                               SelectAllOnFocus="True"
                                                               Value="{Binding Hours, UpdateSourceTrigger=PropertyChanged}"/>
                               
                            </i:Interaction.Behaviors>
                        </TextBox>
                        
                        <TextBlock Text=":"
                                       VerticalAlignment="Center"
                                       Margin="6,0"/>
                        
                        <TextBox Width="40"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <i:Interaction.Behaviors>
                                <local:NumericTimeTextBehavior Mode="MinuteSecond"
                                                               AllowEmpty="False"
                                                               PadOnLostFocus="True"
                                                               SelectAllOnFocus="True"
                                                               Value="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}"/>

                            </i:Interaction.Behaviors>
                        </TextBox>
                        
                        <TextBlock Text=":"
                                       VerticalAlignment="Center"
                                       Margin="6,0"/>
                        
                        <TextBox Width="40"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <i:Interaction.Behaviors>
                                <local:NumericTimeTextBehavior Mode="MinuteSecond"
                                                               AllowEmpty="False"
                                                               PadOnLostFocus="True"
                                                               SelectAllOnFocus="True"
                                                               Value="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}"/>

                            </i:Interaction.Behaviors>
                        </TextBox>
                    </StackPanel>



                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                               HorizontalAlignment="Center"
                               Text="{Binding ValidationMessage}"
                               Foreground="#FFFF4477"
                               Margin="0,6,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" 
                    Width="100" Height="25" 
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="OK" 
                    Width="100" Height="25"
                    IsDefault="True"
                    Command="{Binding OkCommand}"/>
        </StackPanel>
    </Grid>
</Window>
