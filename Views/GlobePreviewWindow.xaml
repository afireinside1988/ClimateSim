<Window x:Class="GlobePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:ClimateSim"
        mc:Ignorable="d"
        Title="Globus-Vorschau" Height="700" Width="1000">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EnumToBooleanConverter x:Key="EnumToBool"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <RadioButton x:Name="RadTopo" Content="Topografie" Margin="0,0,12,0"
                             IsChecked="{Binding SelectedBaseLayer, Converter={StaticResource EnumToBool}, ConverterParameter=Topo}"/>
                <RadioButton Content="LandMask" Margin="0,0,12,0"
                             IsChecked="{Binding SelectedBaseLayer, Converter={StaticResource EnumToBool}, ConverterParameter=LandMask}"/>
                <RadioButton Content="TID"
                             IsChecked="{Binding SelectedBaseLayer, Converter={StaticResource EnumToBool}, ConverterParameter=Tid}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <CheckBox Content="Gitternetz" Margin="0,0,12,0" Width="{Binding ElementName=RadTopo, Path=ActualWidth}"
                          IsChecked="{Binding ShowGrid, Mode=TwoWay}"/>
                <CheckBox Content="Relief" Visibility="{Binding IsReliefOptionVisible, Converter={StaticResource BoolToVis}}"
                          IsChecked="{Binding ShowOverlay, Mode=TwoWay}"/>
                <CheckBox Content="Küstenlinien" Visibility="{Binding IsShoreLinesOptionVisible, Converter={StaticResource BoolToVis}}"
                          IsChecked="{Binding ShowOverlay, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#FF000000" CornerRadius="8" Padding="8">
            <Grid ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">

                <Viewport3D ClipToBounds="True">
                    <i:Interaction.Behaviors>
                        <local:PanAndZoomBehavior
                            BeginPanCommand="{Binding BeginRotateCommand}"
                            PanCommand="{Binding RotateCommand}"
                            EndPanCommand="{Binding EndRotateCommand}"
                            ZoomCommand="{Binding ZoomCommand}"
                            ViewportChangedCommand="{Binding ViewportChangedCommand}"
                            MouseMoveCommand="{Binding MouseMoveCommand}"
                            MouseDownCommand="{Binding MouseDownCommand}"
                            MouseUpCommand="{Binding MouseUpCommand}"/>
                    </i:Interaction.Behaviors>

                    <Viewport3D.Camera>
                        <PerspectiveCamera
                            Position="{Binding CameraPosition}"
                            LookDirection="{Binding CameraLookDirection}"
                            UpDirection="{Binding CameraUpDirection}"
                            FieldOfView="{Binding CameraFov}"/>
                    </Viewport3D.Camera>
                    
                    <!-- Licht -->
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#66666666"/>
                                <DirectionalLight Color="#FFFFFF" Direction="-0.6,-0.3,-1"/>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    
                    <!-- Globus-Modelle -->
                    <ModelVisual3D Content="{Binding GlobeModel}"/>
                </Viewport3D>

            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="8">
            <TextBlock Text="(Debug) Aktuelle Textur:" Opacity="0.7"/>
        </Grid>
    </Grid>
</Window>
