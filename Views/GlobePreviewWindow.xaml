<Window x:Class="GlobePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:ClimateSim"
        mc:Ignorable="d"
        Title="Globus-Vorschau" Height="880" Width="1200">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
        <local:EnumToBooleanConverter x:Key="EnumToBool"/>
        <local:GlobeMeshResolutionTickToStringConverter x:Key="MeshTickToString"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Links: Viewport -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Viewport -->
            <Border Grid.Row="0" Background="#FF000000" CornerRadius="8" Padding="8">
                <Grid ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">

                    <Viewport3D x:Name="Vp" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">

                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseLeave">
                                <i:InvokeCommandAction Command="{Binding MouseLeaveCommand}" PassEventArgsToCommand="True"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <i:Interaction.Behaviors>
                            <local:PanAndZoomBehavior
                                    BeginPanCommand="{Binding BeginRotateCommand}"
                                    PanCommand="{Binding RotateCommand}"
                                    EndPanCommand="{Binding EndRotateCommand}"
                                    ZoomCommand="{Binding ZoomCommand}"
                                    ViewportChangedCommand="{Binding ViewportChangedCommand}"
                                    MouseMoveCommand="{Binding MouseMoveCommand}"
                                    MouseDownCommand="{Binding MouseDownCommand}"
                                    MouseUpCommand="{Binding MouseUpCommand}"/>
                        </i:Interaction.Behaviors>

                        <Viewport3D.Camera>
                            <PerspectiveCamera
                                    Position="{Binding CameraPosition}"
                                    LookDirection="{Binding CameraLookDirection}"
                                    UpDirection="{Binding CameraUpDirection}"
                                    FieldOfView="{Binding CameraFov}"/>
                        </Viewport3D.Camera>

                        <!-- Licht -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="{Binding AmbientLightColor}"/>
                                    <DirectionalLight Color="#FFFFFF" Direction="{Binding SunDirection}"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        <!-- Globus-Modelle -->
                        <ModelVisual3D Content="{Binding GlobeModel}"/>
                    </Viewport3D>

                    <!-- Render-Overlay über dem Viewport -->
                    <Border Background="#AA000000"
                                CornerRadius="6"
                                Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}"
                                IsHitTestVisible="False">

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RenderingTitle}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding RenderingMessage}"
                                           Foreground="#DDFFFFFF"
                                           Opacity="0.9"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Beobachter-Modus-Overlay über dem Viewport -->
                    <Border Background="#00000000"
                            CornerRadius="6"
                            Visibility="{Binding IsObserverMode, Converter={StaticResource BoolToVis}}"
                            IsHitTestVisible="False">

                        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="8,0,8,0"
                                   Foreground="Red"
                                   Opacity="0.75"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Beobachter-Modus"/>

                    </Border>
                </Grid>
            </Border>

            <!-- Status-Bar -->
            <Border Grid.Row="1" Margin="0,8,0,0"
                    Padding="8,6"
                    CornerRadius="6"
                    Background="#22000000"
                    BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#00000000"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsObserverMode}" Value="True">
                                <Setter Property="BorderBrush" Value="#E53635"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Zeile 1: Koordinaten -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Margin="0,0,10,2"
                               Opacity="0.75"
                               Text="Koordinaten:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               FontFamily="Consolas" VerticalAlignment="Bottom"
                               Margin="0,0,5,2"
                               Text="{Binding HoverLatText}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               FontFamily="Consolas" VerticalAlignment="Bottom"
                               Margin="0,0,5,2"
                               Text="{Binding HoverLonText}"/>

                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                            Margin="0,0,0,0"
                            Padding="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="Beobachter entfernen"
                            Command="{Binding ClearObserverCommand}"
                            Visibility="{Binding IsObserverMode, Converter={StaticResource BoolToVis}}"/>

                    <!-- Zeile 2: Sonnenstand -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Margin="0,0,10,2"
                               Opacity="0.75"
                               Text="Sonnenstand:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Margin="0,0,5,2"
                               FontFamily="Consolas" VerticalAlignment="Bottom"
                               Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"
                               Text="{Binding HoverSunHeightText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Margin="0,0,5,2"
                               FontFamily="Consolas" VerticalAlignment="Bottom"
                               Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"
                               Text="{Binding HoverSunAzimuthText}"/>

                    <!-- Mini-Azimut-Pfeil -->
                    <Viewbox Grid.Row="1" Grid.Column="2"
                             Margin="6,0,0,2"
                             Width="10" Height="10"
                             HorizontalAlignment="Right"
                             Stretch="Fill"
                             Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid Width="10" Height="10">
                            <Path Fill="#DD000000"
                                  Data="M5,0 L10,10 L5,7 L0,10 Z"
                                  RenderTransformOrigin="0.5,0.5"
                                  Visibility="{Binding HoverSunAzimuthText, Converter={StaticResource StrToVis}}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding HoverSunAzimuthDeg}"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                    </Viewbox>


                    <!-- Zeile 3: Tageslänge -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Margin="0,0,10,0"
                               Opacity="0.75"
                               Text="Tageslänge:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Margin="0,0,5,0"
                               FontFamily="Consolas" VerticalAlignment="Bottom"
                               Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"
                               Text="{Binding HoverDayLengthText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Margin="0,0,5,0"
                               FontFamily="Consolas" VerticalAlignment="Bottom"
                               Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"
                               Text="{Binding HoverNightLengthText}"/>
                    <Grid Grid.Row="2" Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="0,0,10,0"
                                   Opacity="0.75"
                                   Text="tägliche Insolation:"/>
                        <TextBlock Grid.Column="1"
                                   Margin="0,0,5,0"
                                   FontFamily="Consolas" VerticalAlignment="Bottom"
                                   Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding HoverInsolationMeanText}"
                                   ToolTip="Durchschnittliche Insolation"/>
                        <TextBlock Grid.Column="2"
                                   Margin="0,0,5,0"
                                   FontFamily="Consolas" VerticalAlignment="Bottom"
                                   Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding HoverInsolationEnergyText}"
                                   ToolTip="Tägliche Insolationsenergie (Klicken zum Umschalten MJ ↔ kWh)">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding ToggleInsolationUnitCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- Rechts: Einstellungen -->
        <ScrollViewer Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <TextBlock Text="Globus-Einstellungen" FontSize="16" FontWeight="Bold"
                           Margin="8,0,0,8"/>

                <!-- Layer-Auswahl -->
                <GroupBox Header="Layer" Margin="8">

                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Grid.Row="0" Content="Topografie"
                             IsChecked="{Binding SelectedBaseLayer, Converter={StaticResource EnumToBool}, ConverterParameter=Topo}"/>
                        <RadioButton Grid.Column="0" Grid.Row="1" Content="LandMask"
                             IsChecked="{Binding SelectedBaseLayer, Converter={StaticResource EnumToBool}, ConverterParameter=LandMask}"/>
                        <RadioButton Grid.Column="0" Grid.Row="2" Content="TID"
                             IsChecked="{Binding SelectedBaseLayer, Converter={StaticResource EnumToBool}, ConverterParameter=Tid}"/>

                        <CheckBox Grid.Column="1" Grid.Row="0" Content="Hill-Shading"
                                  IsEnabled="{Binding IsReliefOptionAvailable}"
                                  IsChecked="{Binding ShowOverlay, Mode=TwoWay}"/>
                        <CheckBox Grid.Column="1" Grid.Row="1" Content="Küstenlinien" 
                                  IsEnabled="{Binding IsShoreLinesOptionAvailable}"
                                  IsChecked="{Binding ShowOverlay, Mode=TwoWay}"/>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <CheckBox Content="Gitternetz"
                                      Margin="0,0,0,3"
                                  IsChecked="{Binding ShowGrid, Mode=TwoWay}"/>

                            <CheckBox Content="Pol-Achse"
                                  IsChecked="{Binding ShowAxis, Mode=TwoWay}"/>
                        </StackPanel>

                    </Grid>

                </GroupBox>


                <GroupBox Header="Globus-Darstellung" Margin="8">

                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="8"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Auflösung -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Margin="0,0,8,0"
                                   Text="Auflösung:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ElementName=SldMeshRes, Path=Value, Converter={StaticResource MeshTickToString}}"
                                   TextAlignment="Left" FontFamily="Consolas" VerticalAlignment="Bottom"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Margin="0,0,8,0"
                                   Text="128x64"
                                   TextAlignment="Right" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>

                        <Slider x:Name="SldMeshRes"
                            Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 Minimum="0" Maximum="4"
                                 TickFrequency="1"
                                 IsSnapToTickEnabled="True"
                                 Value="{Binding MeshResolution, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                            <i:Interaction.Behaviors>
                                <local:CommitSliderValueBehavior/>
                            </i:Interaction.Behaviors>
                        </Slider>
                        <TextBlock Grid.Row="2" Grid.Column="3"
                                   Margin="8,0,0,0"
                                   Text="2048x1024" 
                                   TextAlignment="Left" FontFamily="Consolas" 
                                   VerticalAlignment="Center"/>

                        <!-- Displacement-Optionen -->
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="4"
                                  Margin="0,12,0,8"
                                  Content="Displacement-Mapping"
                                  IsChecked="{Binding ShowDisplacement}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Margin="0,0,8,0"
                                   Text="Überhöhung:"/>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding ElementName=SldExaggeration, Path=Value, StringFormat={}{0}x}"
                                   TextAlignment="Left" FontFamily="Consolas" VerticalAlignment="Bottom"/>

                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Margin="0,0,8,0"
                                   Text="0x"
                                   TextAlignment="Right" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="SldExaggeration" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                Minimum="0" Maximum="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                IsEnabled="{Binding ShowDisplacement}"
                                Value="{Binding DisplacementExaggeration, Mode=TwoWay, UpdateSourceTrigger=Explicit}">
                            <i:Interaction.Behaviors>
                                <local:CommitSliderValueBehavior/>
                            </i:Interaction.Behaviors>
                        </Slider>
                        <TextBlock Grid.Row="6" Grid.Column="3"
                                   Margin="8,0,0,0"
                                   Text="100x"
                                   TextAlignment="Left" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                    </Grid>

                </GroupBox>

                <!-- Animation -->
                <GroupBox Header="Simulation" Margin="8">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <CheckBox Content="Erdrotation" HorizontalAlignment="Left"
                                  IsChecked="{Binding IsEarthRotationEnabled, Mode=TwoWay}"/>
                            <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    Margin="3,0,0,0" Width="30"
                                    ToolTip="UTC-Zeit der Simulation festlegen"
                                    Command="{Binding SetSimulationUtcCommand}"
                                    IsEnabled="{Binding IsEarthRotationEnabled}">
                                <Image Style="{StaticResource IconImageStyle}"
                                       Source="/Assets/Icons/UtcDateTimePicker.png"/>
                            </Button>
                        </Grid>
                        

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Geschwindigkeit:" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding AnimationSpeedText}"
                                       FontFamily="Consolas" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Border Width="1" Height="14"
                                    Background="#FF000000"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,2"
                                    IsHitTestVisible="False"/>
                            <Slider Minimum="-7" Maximum="7"
                                TickFrequency="1" SmallChange="1" LargeChange="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding AnimationSpeedTick, Mode=TwoWay}"
                                IsEnabled="{Binding IsEarthRotationEnabled}"/>
                            
                        </Grid>
                        

                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <CheckBox Content="Zenit-Marker" Margin="0,0,0,3"
                                      ToolTip="Punkt auf der Erdoberfläche, an dem die Sonne gerade im Zenit steht."
                                      IsEnabled="{Binding IsEarthRotationEnabled}"
                                      IsChecked="{Binding ShowSubsolarMarker}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29*"/>
                                    <ColumnDefinition Width="122*"/>
                                    <ColumnDefinition Width="151*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Tag/Nacht-Grenze"
                                          ToolTip="Tag/Nacht-Grenze, an der die Sonne den Horizont passiert."
                                          IsEnabled="{Binding IsEarthRotationEnabled}"
                                          IsChecked="{Binding ShowDayNightTerminator}" Grid.ColumnSpan="2"/>
                                <CheckBox Grid.Column="2"
                                          Content="Dämmerungszone"
                                          ToolTip="Zivile 6°-Dämmerungszone, in der nach Sonnenuntergang noch Dämmerung sichtbar ist."
                                          IsEnabled="{Binding IsEarthRotationEnabled}"
                                          IsChecked="{Binding ShowDawnZone}"/>
                            </Grid>

                        </StackPanel>

                        <Grid Grid.Row="4" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Simulationszeit (UTC): "/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom"
                                       Text="{Binding SimulationUtcText}" FontFamily="Consolas"
                                       Visibility="{Binding IsEarthRotationEnabled, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Margin="0,8,0,0"
                                       Text="Astronomische Daten" FontWeight="SemiBold"/>
                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                    Height="16" Width="16" VerticalAlignment="Bottom"
                                    Style="{StaticResource IconButtonStyle}"
                                    IsEnabled="{Binding IsEarthRotationEnabled}"
                                    Command="{Binding ToggleAstroExpandedCommand}">
                                <Image SnapsToDevicePixels="True"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Width="16" Height="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="/Assets/Icons/ArrowUp.png"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAstroExpanded}" Value="False">
                                                    <Setter Property="Source" Value="/Assets/Icons/ArrowDown.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Button>

                            <Border Grid.Row="2" Grid.ColumnSpan="2"
                                    Margin="0,6,0,0"
                                    Background="#00000000"
                                    ClipToBounds="True">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="MaxHeight" Value="240"/>
                                        <Style.Triggers>

                                            <!-- Wenn Erdrotation aus: einklappen -->
                                            <DataTrigger Binding="{Binding IsEarthRotationEnabled}" Value="False">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.10"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                             To="0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                            </DataTrigger>

                                            <!-- Collapse-Animation -->
                                            <DataTrigger Binding="{Binding IsAstroExpanded}" Value="False">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.10"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                             To="0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>

                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.10"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                             To="240" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                                <Setter Property="IsHitTestVisible" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Solare Deklination -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Margin="0,6,0,0"
                                               Text="Solare Deklination:"
                                               ToolTip="Winkel der Sonne relativ zur Äquatorebene der Erde (in Grad)"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Margin="8,0,0,0" VerticalAlignment="Bottom"
                                               Text="{Binding SolarDeclinationText}" FontFamily="Consolas"
                                               ToolTip="Winkel der Sonne relativ zur Äquatorebene der Erde (in Grad)"/>

                                    <!-- Subsolarpunkt -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Margin="0,4,0,0"
                                               Text="Subsolarpunkt (Zenit):"
                                               ToolTip="Ort, an dem Sonne senkrecht steht"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Margin="8,0,0,0" VerticalAlignment="Bottom"
                                               Text="{Binding SubsolarText}" FontFamily="Consolas"
                                               ToolTip="Ort, an dem Sonne senkrecht steht"/>

                                    <!-- RA -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Margin="0,4,0,0"
                                               Text="Rektaszension (Sonne):"
                                               ToolTip="Himmelslängengrad der Sonne im Äquatorsystem"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Margin="8,0,0,0" VerticalAlignment="Bottom"
                                               Text="{Binding SunRaText}" FontFamily="Consolas"
                                               ToolTip="Himmelslängengrad der Sonne im Äquatorsystem"/>

                                    <!-- GMST -->
                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Margin="0,4,0,0"
                                               Text="GMST:"
                                               ToolTip="Rotationswinkel der Erde relativ zu den Fixsternen (in Relation zu Greenwich)"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Margin="8,0,0,0" VerticalAlignment="Bottom"
                                               Text="{Binding GmstText}" FontFamily="Consolas"
                                               ToolTip="Rotationswinkel der Erde relativ zu den Fixsternen (in Relation zu Greenwich)"/>

                                    <!-- EoT -->
                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                               Margin="0,4,0,0"
                                               Text="Zeitabweichung:"
                                               ToolTip="Differenz zwischen Sonnenzeit und mittlerer Uhrzeit (UTC)"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1"
                                               Margin="8,0,0,0" VerticalAlignment="Bottom"
                                               Text="{Binding EquationOfTimeText}" FontFamily="Consolas"
                                               ToolTip="Differenz zwischen Sonnenzeit und mittlerer Uhrzeit (UTC)"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Kamera" Margin="8">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Kamera-Modus:" Margin="0,0,0,4"/>

                        <RadioButton Grid.Row="1" Grid.Column="0"
                                     Content="Raumfest"
                                     ToolTip="Inertiales Bezugssystem"
                                     IsChecked="{Binding FrameMode, Converter={StaticResource EnumToBool}, ConverterParameter=RotatingEarth}"/>
                        <RadioButton Grid.Row="1" Grid.Column="1"
                                     Content="Erdfest"
                                     ToolTip="Körperfestes Bezugssystem"
                                     IsChecked="{Binding FrameMode, Converter={StaticResource EnumToBool}, ConverterParameter=EarthFixed}"/>

                        <Button Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Content="Kamera zurücksetzen"
                                Width="120" Height="25"
                                Command="{Binding ResetCameraCommand}"/>
                    </Grid>
                </GroupBox>

                <!-- Cache -->
                <GroupBox Header="Cache" Margin="8">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Cache-Größe:" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding CacheSize}"
                                       TextAlignment="Left" VerticalAlignment="Bottom"
                                       FontFamily="Consolas"/>

                        </StackPanel>
                        <Button Grid.Row="1"
                                Width="120" Height="25"
                                HorizontalAlignment="Left"
                                Content="Cache leeren"
                                Command="{Binding ClearCacheCommand}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Window>
