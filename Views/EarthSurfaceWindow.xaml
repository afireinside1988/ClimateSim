<Window x:Class="EarthSurfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:climatesim="clr-namespace:ClimateSim"
        xmlns:local="clr-namespace:ClimateSim"
        xmlns:conv="clr-namespace:ClimateSim"
        mc:Ignorable="d"
        Title="Erdoberfläche (Cache-Generator)" 
        Height="787" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBool"/>
        <conv:BooleanAndToVisibilityConverter x:Key="AndToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Menü -->

        <Menu Grid.Row="0">
            <MenuItem Header="_Cache">
                <MenuItem Header="Cache _laden" Command="{Binding LoadCacheCommand}"/>
                <Separator/>
                <MenuItem Header="Cache _generieren" Command="{Binding GenerateCacheCommand}" IsEnabled="{Binding CanGenerateCache}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <!-- 2 Spalten: links Preview, rechts Settings -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT: PREVIEW -->
            <Border Grid.Column="0"
                Margin="12"
                Padding="12"
                CornerRadius="10"
                BorderBrush="#22000000"
                BorderThickness="1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="*"/>
                        <!-- Preview -->
                        <RowDefinition Height="Auto"/>
                        <!-- Hover -->
                    </Grid.RowDefinitions>

                    <!-- Header + Layer-Toggles -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Vorschau" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <WrapPanel>
                            <CheckBox Content="Höhen-Relief" IsChecked="{Binding ShowReliefLayer}" Margin="0,0,12,0" />
                            <CheckBox Content="Hill-Shading" IsChecked="{Binding UseHillShading}" Margin="0,0,12,0" IsEnabled="{Binding ShowReliefLayer}"/>
                            <CheckBox Content="Land-Maske" IsChecked="{Binding ShowLandMaskLayer}" Margin="0,0,12,0"/>
                            <CheckBox Content="Küstenlinien" IsChecked="{Binding ShowShoreLines}" Margin="0,0,12,0" IsEnabled="{Binding ShowLandMaskLayer}"/>
                            <CheckBox Content="TID (Quell-Info)" IsChecked="{Binding ShowTidLayer}" Margin="0,0,12,0"/>
                            <CheckBox Content="Gitternetz" IsChecked="{Binding ShowGridLayer}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Preview Image -->
                    <Border Grid.Row="1"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        Background="#66000000"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                        <Grid x:Name="MapHost"
                              ClipToBounds="True"
                              Background="#66000000"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="73*"/>
                                <ColumnDefinition Width="655*"/>
                            </Grid.ColumnDefinitions>

                            <i:Interaction.Triggers>
                                <!--
                                <i:EventTrigger EventName="MouseMove">
                                    <i:InvokeCommandAction Command="{Binding MapMouseMoveCommand}" PassEventArgsToCommand="True"/>
                                </i:EventTrigger> -->
                                <i:EventTrigger EventName="MouseLeave">
                                    <i:InvokeCommandAction Command="{Binding MapMouseLeaveCommand}" PassEventArgsToCommand="True"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <i:Interaction.Behaviors>
                                <local:PanAndZoomBehavior
                                    BeginPanCommand="{Binding BeginPanCommand}"
                                    PanCommand="{Binding PanCommand}"
                                    EndPanCommand="{Binding EndPanCommand}"
                                    ZoomCommand="{Binding ZoomCommand}"
                                    HoverCommand="{Binding MapMouseMoveCommand}"
                                    ViewportChangedCommand="{Binding ViewportChangedCommand}" />
                            </i:Interaction.Behaviors>


                            <Canvas x:Name="MapContent"
                                  Width="{Binding ContentWidth}"
                                  Height="{Binding ContentHeight}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  SnapsToDevicePixels="True"
                                  UseLayoutRounding="True">

                                <Canvas.Resources>
                                    <Style TargetType="{x:Type Image}">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                        <Setter Property="Stretch" Value="None"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
                                    </Style>
                                </Canvas.Resources>


                                <!-- Gemeinsamer Transform für ALLE Layer -->
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding Zoom}"
                                                        ScaleY="{Binding Zoom}"/>
                                        <TranslateTransform X="{Binding PanX}"
                                                            Y="{Binding PanY}"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- Layer 1: Surface -->
                                <Image Source="{Binding SurfaceLayer}"/>

                                <!-- Layer 2: Relief (später) -->
                                <Image Source="{Binding ReliefLayer}"
                                   Visibility="{Binding ShowReliefLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 3: LandMask -->
                                <Image Source="{Binding LandMaskLayer}"
                                   Visibility="{Binding ShowLandMaskLayer, Converter={StaticResource BoolToVis}}"/>
                                
                                <!-- Layer 4: Küstenlinien -->
                                <Image Source="{Binding ShoreLineLayer}"
                                       Visibility="{Binding ShowShoreLines, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 5: TID (später) -->
                                <Image Source="{Binding TidLayer}"
                                   Visibility="{Binding ShowTidLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 6: Grid (später) -->
                                <Image Source="{Binding GridLayer}"
                                   Visibility="{Binding ShowGridLayer, Converter={StaticResource BoolToVis}}"/>

                            </Canvas>

                            <Grid
                                  IsHitTestVisible="False" Grid.ColumnSpan="2">

                                <!-- NoPreview-Text (wird angezeigt, solang keine Preview erstellt/geladen wurde -->
                                <TextBlock Text="Noch keine Vorschau - Cache generieren oder laden."
                                   Foreground="#AAFFFFFF"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SurfaceLayer}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>


                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Hover / Info -->
                    <StatusBar Grid.Row="2">
                        <StatusBarItem>
                            <TextBlock MinWidth="90" FontFamily="Consolas" Text="{Binding StatusLatText}"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock MinWidth="90" FontFamily="Consolas" Text="{Binding StatusLonText}" Margin="0,0,20,0"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock MinWidth="100" FontFamily="Consolas" Text="{Binding StatusHeightText}" Margin="0,0,20,0"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock MinWidth="100" Margin="0,0,50,0" FontFamily="Consolas" Text="{Binding StatusSurfaceText}"/>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock TextAlignment="Right" MinWidth="100" FontFamily="Consolas" Text="{Binding StatusZoomText}"/>
                        </StatusBarItem>
                    </StatusBar>

                </Grid>
            </Border>

            <!-- RIGHT: SETTINGS -->
            <ScrollViewer Grid.Column="1"
                      Margin="12,12,12,12"
                      Padding="0,0,5,0"
                      VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Einstellungen"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                    <!-- Rohdaten -->
                    <GroupBox Header="Rohdaten" Margin="0,0,0,10">
                        <StackPanel Margin="10">

                            <TextBlock Text="Quelle (Name)" Opacity="0.8"/>
                            <TextBox Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                            <TextBlock Text="GEBCO Height (Pfad)" Opacity="0.8"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Text="{Binding RawHeightFile, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Width="34" Command="{Binding BrowseHeightCommand}"/>
                            </Grid>
                            <TextBlock Text="TID (optional)" Opacity="0.8"/>

                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Text="{Binding RawTidFile, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Width="34" Command="{Binding BrowseTidCommand}"/>
                            </Grid>

                            <TextBlock Text="Land-Maske" Opacity="0.8"/>
                            <StackPanel Margin="0,4,0,0" Orientation="Vertical">
                                <RadioButton Content="Aus Höhe ableiten (LandMask-Builder)"
                                         IsChecked="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=FromHeight}"/>
                                <RadioButton Content="Aus TID auslesen"
                                         IsChecked="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=FromTid0}"/>
                                <RadioButton Content="Aus externer LandMask-Datei (nicht implementiert)"
                                         IsChecked="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=ExternalSource}"/>
                            </StackPanel>

                            <!-- External LandMask Path (aktuell nicht implementiert -->
                            <Grid Margin="0,10,0,0" Opacity="0.55" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Text="{Binding RawLandMaskFile, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Width="34" Command="{Binding BrowseLandMaskCommand}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Zielraster -->
                    <GroupBox Header="Zielraster" Margin="0,0,0,10">

                        <Grid Margin="10,10,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Margin="10,0,30,0" Grid.Column="0">

                                <TextBlock Text="Auflösung" Opacity="0.8"/>
                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <RadioButton Content="1°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg1}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="0,5°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg0_5}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="0,25°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg0_25}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0" Grid.Column="1">
                                <TextBlock Text="Resampling" Opacity="0.8"/>
                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <RadioButton Content="Nearest"
                                         IsChecked="{Binding SelectedResampling, Converter={StaticResource EnumToBool}, ConverterParameter=Nearest}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="Bilinear"
                                         IsChecked="{Binding SelectedResampling, Converter={StaticResource EnumToBool}, ConverterParameter=Bilinear}"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </GroupBox>

                    <!-- LandMask-Builder -->
                    <GroupBox Header="LandMask-Builder" Margin="0,0,0,10" IsEnabled="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=FromHeight}">
                        <StackPanel Margin="10">

                            <CheckBox Content="Hysterese-Filter aktivieren"
                                  IsChecked="{Binding UseHysteresis}"
                                  IsEnabled="{Binding IsLandMaskBuilderEnabled}"/>
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding IsHysteresisIterationsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Iterationen:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1"
                                    Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding HysteresisIterations}"/>
                                <TextBlock Grid.Column="2" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding HysteresisIterations}"/>
                            </Grid>

                            <TextBlock Margin="0,10,0,0" Opacity="0.8"
                                   Text="{Binding LandMaskVariantTag, StringFormat=Cache-Variante: {0}}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cache generieren"
                            Width="140" Height="32" Margin="0,0,8,0"
                            Command="{Binding GenerateCacheCommand}"
                            IsEnabled="{Binding CanGenerateCache}"/>
                        <Button Content="Cache-Ordner"
                            Width="110" Height="32"
                            Command="{Binding OpenCacheFolderCommand}"/>
                    </StackPanel>

                    <!-- Status -->
                    <TextBox Margin="0,12,0,0" Height="110"
                         Text="{Binding LastReport}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>


        </Grid>

        <!-- Overlay -->
        <climatesim:ProgressOverlay Panel.ZIndex="999"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">

            <climatesim:ProgressOverlay.Visibility>
                <MultiBinding Converter="{StaticResource AndToVis}">
                    <Binding Path="IsBusy"/>
                    <Binding Path="BusyShowOverlay"/>
                </MultiBinding>
            </climatesim:ProgressOverlay.Visibility>
        </climatesim:ProgressOverlay>
    </Grid>
</Window>
