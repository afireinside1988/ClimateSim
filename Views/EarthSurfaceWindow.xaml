<Window x:Class="EarthSurfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:climatesim="clr-namespace:ClimateSim"
        xmlns:local="clr-namespace:ClimateSim"
        xmlns:conv="clr-namespace:ClimateSim"
        mc:Ignorable="d"
        Title="Erdoberfläche (Cache-Generator)" 
        Height="787" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBool"/>
        <conv:BooleanAndToVisibilityConverter x:Key="AndToVis"/>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconImageStyle" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        </Style>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Menü -->

        <Menu Grid.Row="0">
            <MenuItem Header="_Cache">
                <MenuItem Header="Cache _laden" Command="{Binding LoadCacheCommand}"/>
                <Separator/>
                <MenuItem Header="Cache _generieren" Command="{Binding GenerateCacheCommand}" IsEnabled="{Binding CanGenerateCache}"/>
            </MenuItem>
        </Menu>

        <Grid Margin="12" Grid.Row="1">
            <!-- 2 Spalten: links Preview, rechts Settings -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT: PREVIEW -->
            <Border Grid.Column="0"
                Padding="12"
                CornerRadius="10"
                BorderBrush="#22000000"
                BorderThickness="1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="*"/>
                        <!-- Preview -->
                        <RowDefinition Height="Auto"/>
                        <!-- Hover -->
                    </Grid.RowDefinitions>

                    <!-- Header + Layer-Toggles -->
                    <StackPanel x:Name="HeaderStack" Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Vorschau" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid MinHeight="25" Width="{Binding ElementName=HeaderStack, Path=ActualWidth}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Layer-Auswahl -->
                                <RowDefinition Height="Auto"/> <!-- Layer-Optionen -->
                                <RowDefinition Height="Auto"/> <!-- Werkzeugleiste für Editor -->
                            </Grid.RowDefinitions>
                            
                            <!-- Layer-Auswhal -->
                            <WrapPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">
                                <RadioButton x:Name="RadioTopo" Content="Topografie" IsChecked="{Binding ShowTopoLayer}" Margin="0,0,12,0" />
                                <RadioButton Content="Land-Maske" IsChecked="{Binding ShowLandMaskLayer}" Margin="0,0,12,0"/>
                                <RadioButton Content="TID (Quell-Info)" IsChecked="{Binding ShowTidLayer}" Margin="0,0,12,0"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0">
                                <CheckBox Content="Editor-Modus" IsChecked="{Binding IsEditMode}" VerticalAlignment="Center"/>
                                <Button Margin="10,0,0,0"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding OpenGlobePreviewCommand}"
                                        IsEnabled="{Binding CanOpenGlobePreview}"
                                        ToolTip="3D-Globus-Vorschau">
                                    <Image Style="{StaticResource IconImageStyle}"
                                               Source="pack://application:,,,/Assets/Icons/Globe.png"/>
                                </Button>
                            </StackPanel>
                            
                            
                            
                            <!-- Layer-Optionen -->
                            <WrapPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,5,0,0">
                                <CheckBox Content="Gitternetz" IsChecked="{Binding ShowGridLayer}" Margin="0,0,12,0"
                                          Width="{Binding ElementName=RadioTopo, Path=ActualWidth}"/>
                                <CheckBox Content="Höhen-Relief" IsChecked="{Binding ShowReliefLayer}" Margin="0,0,12,0"
                                          Visibility="{Binding ShowTopoLayer, Converter={StaticResource BoolToVis}}"/>
                                <CheckBox Content="Küstenlinien" IsChecked="{Binding ShowShoreLines}" Margin="0,0,12,0"
                                          IsEnabled="{Binding ShowLandMaskLayer}"
                                          Visibility="{Binding ShowLandMaskLayer, Converter={StaticResource BoolToVis}}"/>
                                <CheckBox Content="TID-Legende"
                                          Visibility="{Binding ShowTidLayer, Converter={StaticResource BoolToVis}}"
                                          Command="{Binding ToggleTidLegendCommand}"/>
                            </WrapPanel>
                            
                            <!-- Toolbar für Editor -->
                            <WrapPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,10,0,0"
                                       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding SaveEditsCommand}"
                                        IsEnabled="{Binding CanSaveEdits}"
                                        ToolTip="Speichern">
                                    <Image Style="{StaticResource IconImageStyle}"
                                           Source="pack://application:,,,/Assets/Icons/Save.png"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding SaveEditsAsCommand}"
                                        IsEnabled="{Binding CanSaveEdits}"
                                        ToolTip="Speichern Als">    
                                    <Image Style="{StaticResource IconImageStyle}"
                                           Source="pack://application:,,,/Assets/Icons/SaveAs.png"/>
                                </Button>
                                
                                <Separator Margin="4,0,4,0"/>
                                
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding UndoEditsCommand}"
                                        IsEnabled="{Binding CanUndoEdits}"
                                        ToolTip="Rückgängig">
                                    <Image Style="{StaticResource IconImageStyle}"
                                           Source="pack://application:,,,/Assets/Icons/Undo.png"/>
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding RedoEditsCommand}"
                                        IsEnabled="{Binding CanRedoEdits}"
                                        ToolTip="Wiederholen">
                                    <Image Style="{StaticResource IconImageStyle}"
                                           Source="pack://application:,,,/Assets/Icons/Redo.png"/>
                                </Button>

                                <Separator Margin="4,0,4,0"/>
                                
                                <TextBlock Text="Kanal:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Width="140"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding EditChannels}"
                                          SelectedItem="{Binding SelectedEditChannel, Mode=TwoWay}"
                                          IsEnabled="True">
                                </ComboBox>

                                <Separator Margin="4,0,4,0"/>
                                
                                <!-- Height-Kanal-Tools -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedEditChannel}" Value="{x:Static local:EditChannel.Height}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <CheckBox Content="Spikes anzeigen"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ShowHeightSpikeLayer}"/>

                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding JumpNextSpikeCommand}"
                                            IsEnabled="{Binding CanJumpNextSpike}"
                                            ToolTip="Ansicht auf den nächsten Spike zentrieren">
                                        <Image Style="{StaticResource IconImageStyle}"
                                               Source="pack://application:,,,/Assets/Icons/NextSpike.png"/>
                                    </Button>

                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding HeightSpikeCount, StringFormat=Spikes: {0:N0}}"/>
                                </StackPanel>
                            </WrapPanel>
                            
                        </Grid>
                    
                    </StackPanel>

                    <!-- Preview Image -->
                    <Border Grid.Row="1"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        Background="#66000000"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                        <Grid x:Name="MapHost"
                              ClipToBounds="True"
                              Background="#66000000"
                              SnapsToDevicePixels="True"
                              UseLayoutRounding="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="73*"/>
                                <ColumnDefinition Width="655*"/>
                            </Grid.ColumnDefinitions>

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeave">
                                    <i:InvokeCommandAction Command="{Binding MapMouseLeaveCommand}" PassEventArgsToCommand="True"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>

                            <i:Interaction.Behaviors>
                                <local:PanAndZoomBehavior
                                    BeginPanCommand="{Binding BeginPanCommand}"
                                    PanCommand="{Binding PanCommand}"
                                    EndPanCommand="{Binding EndPanCommand}"
                                    ZoomCommand="{Binding ZoomCommand}"
                                    ViewportChangedCommand="{Binding ViewportChangedCommand}" 
                                    MouseDownCommand="{Binding MapMouseDownCommand}" 
                                    MouseUpCommand="{Binding MapMouseUpCommand}"
                                    MouseMoveCommand="{Binding MapMouseMoveCommand}" />
                            </i:Interaction.Behaviors>


                            <Canvas x:Name="MapContent"
                                  Width="{Binding ContentWidth}"
                                  Height="{Binding ContentHeight}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  SnapsToDevicePixels="True"
                                  UseLayoutRounding="True">

                                <Canvas.Resources>
                                    <Style TargetType="{x:Type Image}">
                                        <Setter Property="Canvas.Left" Value="0"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                        <Setter Property="Stretch" Value="None"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
                                    </Style>
                                </Canvas.Resources>


                                <!-- Gemeinsamer Transform für ALLE Layer -->
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding Zoom}"
                                                        ScaleY="{Binding Zoom}"/>
                                        <TranslateTransform X="{Binding PanPoint.X}"
                                                            Y="{Binding PanPoint.Y}"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- Layer 1: Surface -->
                                <Image Source="{Binding SurfaceLayer}" x:Name="SurfaceMap"/>

                                <!-- Layer 2: Topografie-->
                                <Image Source="{Binding TopoLayer}"
                                       Visibility="{Binding ShowTopoLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 3: Relief -->
                                <Image Source="{Binding ReliefLayer}"
                                       Visibility="{Binding ShowReliefLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 4: LandMask -->
                                <Image Source="{Binding LandMaskLayer}"
                                       Visibility="{Binding ShowLandMaskLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 5: Küstenlinien -->
                                <Image Source="{Binding ShoreLineLayer}"
                                       Visibility="{Binding ShowShoreLines, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 6: TID -->
                                <Image Source="{Binding TidLayer}"
                                       Visibility="{Binding ShowTidLayer, Converter={StaticResource BoolToVis}}"/>
                                
                                <!-- Layer 7: Height-Spike-Overlay -->
                                <Image Source="{Binding HeightSpikeLayer}"
                                       Visibility="{Binding ShowHeightSpikeLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Layer 8: EditOverlay -->
                                <Image Source="{Binding EditOverlayLayer}"
                                       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                                       IsHitTestVisible="False"/>

                                <!-- Hover-Zelle als Overlay für Editing -->
                                <Rectangle Width="1"
                                           Height="1"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding IsHoverCellVisible, Converter={StaticResource BoolToVis}}"
                                           Canvas.Left="{Binding HoverCellPoint.X}"
                                           Canvas.Top="{Binding HoverCellPoint.Y}"
                                           SnapsToDevicePixels="True"
                                           Fill="#40FF0000"
                                           Stroke="#A0FF0000"
                                           StrokeThickness="0.08"
                                           RenderOptions.EdgeMode="Aliased" />

                            </Canvas>

                            <!-- Overlay (Screen-Space; zoomt/panned NICHT!) -->
                            <Canvas x:Name="MapOverlay"
                                    IsHitTestVisible="True"
                                    Panel.ZIndex="50"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">

                                <!-- Grid-Layer (screen-space, wird pro Viewport gerendert) -->
                                <local:GeoGridOverlay2D
                                    Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="{Binding ElementName=MapHost, Path=ActualWidth}"
                                    Height="{Binding ElementName=MapHost, Path=ActualHeight}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding ShowGridLayer,Converter={StaticResource BoolToVis}}"
                                    RenderOptions.EdgeMode="Aliased"
                                    Zoom="{Binding Zoom}"
                                    PanPoint="{Binding PanPoint}"
                                    ContentSize="{Binding ContentSize}"
                                    ContentCellSizeDeg="{Binding ContentCellSizeDeg}"/>

                                <!-- Floating-Label am Mauszeiger -->
                                <Border Visibility="{Binding ShowHoverOverlay, Converter={StaticResource BoolToVis}}"
                                        Canvas.Left="{Binding HoverOverlayPoint.X}"
                                        Canvas.Top="{Binding HoverOverlayPoint.Y}"
                                        Background="#E0101010"
                                        BorderBrush="#FFDDDDDD"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="{Binding HoverOverlayText}"
                                               Foreground="#FFFFFFFF"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>
                                
                                <!-- Legend-Popup (verschiebbar) -->
                                <Border x:Name="TidLegendBorder"
                                        Visibility="{Binding IsTidLegendOpen, Converter={StaticResource BoolToVis}}"
                                        Canvas.Left="{Binding TidLegendPoint.X}"
                                        Canvas.Top="{Binding TidLegendPoint.Y}"
                                        Background="#F0181818"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="3"
                                        SnapsToDevicePixels="True">

                                    <Grid Width="260">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Background="#FF222222">
                                           
                                            
                                            <!-- Header / Drag -->
                                            
                                              <!-- Thumb ist der saubere Weg für Drag -->
                                            <Thumb x:Name="TidLegendThumb"
                                                   Cursor="SizeAll"
                                                   DragDelta="TidLegendThumb_DragDelta"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   Panel.ZIndex="2">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Rectangle Fill="Transparent"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                                
                                                 <Button Content="X"
                                                        DockPanel.Dock="Right"
                                                        Width="22" Height="22"
                                                        Margin="10,0,0,0"
                                                        Command="{Binding CloseTidLegendCommand}"
                                                        Padding="0"
                                                        Background="#00FFFFFF"
                                                        BorderBrush="#00FFFFFF"
                                                        Foreground="#CCFFFFFF"
                                                        Panel.ZIndex="3"
                                                        HorizontalAlignment="Right"/>

                                                <TextBlock Text="GEBCO TID-Legende"
                                                           Foreground="#FFFFFFFF"
                                                           FontWeight="SemiBold"
                                                           IsHitTestVisible="False"
                                                           TextAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Margin="5,0,0,0"/>

                                        </Grid>
                                        
                                        
                                        <!-- Items -->
                                        <ScrollViewer Grid.Row="1"
                                                      Padding="10"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="340">
                                            <ItemsControl ItemsSource="{Binding TidLegendItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Farbbox -->
                                                            <Border Grid.Column="0"
                                                                    Width="18" Height="18"
                                                                    CornerRadius="3"
                                                                    Background="{Binding Brush}"
                                                                    BorderBrush="#55000000"
                                                                    BorderThickness="1"/>
                                                            <!-- Text -->
                                                            <StackPanel Grid.Column="2">
                                                                <!-- Titel -->
                                                                <TextBlock Text="{Binding TidTitle}"
                                                                       Foreground="#FFFFFFFF"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"/>
                                                                
                                                                <!-- Beschreibung -->
                                                                <TextBlock Text="{Binding TidDescription}"
                                                                           Foreground="#B0FFFFFF"
                                                                           FontSize="9"
                                                                           Margin="0,2,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                        </ScrollViewer>
                                    </Grid>
                                    
                                </Border>
                            </Canvas>

                            <Grid
                                  IsHitTestVisible="False" Grid.ColumnSpan="2">

                                <!-- NoPreview-Text (wird angezeigt, solang keine Preview erstellt/geladen wurde -->
                                <TextBlock Text="Noch keine Vorschau - Cache generieren oder laden."
                                   Foreground="#AAFFFFFF"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopoLayer}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>


                            </Grid>

                        </Grid>

                    </Border>

                    <!-- Statusbar -->
                    <StatusBar Grid.Row="2">
                        <StatusBarItem>
                            <TextBlock MinWidth="90" FontFamily="Consolas" Text="{Binding StatusLatText}"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock MinWidth="90" FontFamily="Consolas" Text="{Binding StatusLonText}" Margin="0,0,20,0"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock MinWidth="100" FontFamily="Consolas" Text="{Binding StatusHeightText}" Margin="0,0,20,0"/>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock MinWidth="100" Margin="0,0,50,0" FontFamily="Consolas" Text="{Binding StatusSurfaceText}"/>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Right">
                            <TextBlock TextAlignment="Right" MinWidth="100" FontFamily="Consolas" Text="{Binding StatusZoomText}"/>
                        </StatusBarItem>
                    </StatusBar>

                </Grid>
            </Border>

            <!-- RIGHT: SETTINGS -->
            <ScrollViewer Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Visible">

                <StackPanel>

                    <TextBlock Text="Cache-Einstellungen"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="8,0,0,10"/>

                    <!-- Rohdaten -->
                    <GroupBox Header="Rohdaten" Margin="8">
                        <StackPanel Margin="10">

                            <TextBlock Text="Quelle (Name)" Opacity="0.8"/>
                            <TextBox Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                            <TextBlock Text="GEBCO Height (Pfad)" Opacity="0.8"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Text="{Binding RawHeightFile, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"
                                         ToolTip="Entfernen mit [Entf] oder [Backspace]">
                                    <i:Interaction.Behaviors>
                                        <local:ClearOnDeleteBehavior Command="{Binding ClearHeightFileCommand}"/>
                                    </i:Interaction.Behaviors>
                                </TextBox>
                                <Button Grid.Column="1" Content="..." Width="34" Command="{Binding BrowseHeightCommand}"/>
                            </Grid>
                            <TextBlock Text="TID (optional)" Opacity="0.8"/>

                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Text="{Binding RawTidFile, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"
                                         ToolTip="Entfernen mit [Entf] oder [Backspace]">
                                    <i:Interaction.Behaviors>
                                        <local:ClearOnDeleteBehavior Command="{Binding ClearTidFileCommand}"/>
                                    </i:Interaction.Behaviors>
                                </TextBox>
                                <Button Grid.Column="1" Content="..." Width="34" Command="{Binding BrowseTidCommand}"/>
                            </Grid>

                            <TextBlock Text="Land-Maske" Opacity="0.8"/>
                            <StackPanel Margin="0,4,0,0" Orientation="Vertical">
                                <RadioButton Content="Aus Höhe ableiten (LandMask-Builder)"
                                         IsChecked="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=FromHeight}"/>
                                <RadioButton Content="Aus TID auslesen"
                                         IsChecked="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=FromTid0}"
                                             IsEnabled="{Binding HasTidFile}"/>
                                <RadioButton Content="Aus externer LandMask-Datei (nicht implementiert)"
                                         IsChecked="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=ExternalSource}"/>
                            </StackPanel>

                            <!-- External LandMask Path (aktuell nicht implementiert -->
                            <Grid Margin="0,10,0,0" Opacity="0.55" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Text="{Binding RawLandMaskFile, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="..." Width="34" Command="{Binding BrowseLandMaskCommand}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Zielraster -->
                    <GroupBox Header="Zielraster" Margin="8">

                        <Grid Margin="10,10,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Margin="10,0,30,0" Grid.Column="0">

                                <TextBlock Text="Auflösung" Opacity="0.8"/>
                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <RadioButton Content="1°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg1}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="0,5°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg0_5}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="0,25°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg0_25}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="0,125°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg0_125}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="0,0625°"
                                         IsChecked="{Binding SelectedCellSize, Converter={StaticResource EnumToBool}, ConverterParameter=Deg0_0625}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0" Grid.Column="1">
                                <TextBlock Text="Resampling" Opacity="0.8"/>
                                <StackPanel Orientation="Vertical" Margin="0,4,0,0">
                                    <RadioButton Content="Nearest"
                                         IsChecked="{Binding SelectedResampling, Converter={StaticResource EnumToBool}, ConverterParameter=Nearest}"
                                         Margin="0,0,0,4"/>
                                    <RadioButton Content="Bilinear"
                                         IsChecked="{Binding SelectedResampling, Converter={StaticResource EnumToBool}, ConverterParameter=Bilinear}"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </GroupBox>

                    <!-- LandMask-Builder -->
                    <GroupBox Header="LandMask-Builder" Margin="8" IsEnabled="{Binding SelectedLandMaskMode, Converter={StaticResource EnumToBool}, ConverterParameter=FromHeight}">
                        <StackPanel Margin="10">

                            <CheckBox Content="Hysterese-Filter aktivieren"
                                  IsChecked="{Binding UseHysteresis}"
                                  IsEnabled="{Binding IsLandMaskBuilderEnabled}"/>
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding IsHysteresisIterationsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Iterationen:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1"
                                    Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding HysteresisIterations}"/>
                                <TextBlock Grid.Column="2" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding HysteresisIterations}"/>
                            </Grid>

                            <TextBlock Margin="0,10,0,0" Opacity="0.8"
                                   Text="{Binding LandMaskVariantTag, StringFormat=Cache-Variante: {0}}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cache generieren"
                            Width="140" Height="32" Margin="0,0,8,0"
                            Command="{Binding GenerateCacheCommand}"
                            IsEnabled="{Binding CanGenerateCache}"/>
                    </StackPanel>

                    <!-- Status -->
                    <TextBox Margin="8" Height="110"
                         Text="{Binding LastReport}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Overlay -->
        <climatesim:ProgressOverlay Panel.ZIndex="999"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">

            <climatesim:ProgressOverlay.Visibility>
                <MultiBinding Converter="{StaticResource AndToVis}">
                    <Binding Path="IsBusy"/>
                    <Binding Path="BusyShowOverlay"/>
                </MultiBinding>
            </climatesim:ProgressOverlay.Visibility>
        </climatesim:ProgressOverlay>
    </Grid>
</Window>
